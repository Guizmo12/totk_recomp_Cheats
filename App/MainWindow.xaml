<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:HyruleCompanion" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" x:Class="HyruleCompanion.MainWindow" Title="Hyrule Companion" Width="1440" Height="920" MinWidth="1120" MinHeight="720" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True" Loaded="WindowLoaded" Closing="WindowClosing" SizeChanged="WindowSizeChanged">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
 </shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <DataTemplate x:Key="ItemCard">
   <local:OrnateFrame Width="{DynamicResource ItemCardWidth}" Height="183" Padding="12,9" BorderThickness="1" CornerSize="11" local:Chrome.HoverLift="True">
    <local:OrnateFrame.Style>
     <Style TargetType="local:OrnateFrame">
      <Setter Property="Background" Value="{StaticResource CardBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GoldLineBrush}"/>
      <Style.Triggers>
       <DataTrigger Binding="{Binding IsCurrent}" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
        <Setter Property="Background" Value="{StaticResource ButtonHoverBrush}"/>
       </DataTrigger>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
       </Trigger>
      </Style.Triggers>
     </Style>
    </local:OrnateFrame.Style>
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="24"/>
      <RowDefinition Height="92"/>
      <RowDefinition Height="*"/>
     </Grid.RowDefinitions>
     <TextBlock Text="{Binding Category}" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/>
     <Button Content="{Binding Star}" Tag="{Binding}" Click="FavoriteClick" Style="{StaticResource Ghost}" FontSize="22" Padding="4,0" HorizontalAlignment="Right" ToolTip="Add or remove favorite" AutomationProperties.Name="Toggle item favorite"/>
     <Grid Grid.Row="1">
      <Ellipse Fill="{StaticResource ArtHaloBrush}" Width="112" Height="101"/>
      <local:SheikahSeal Width="93" Height="93" Opacity=".14"/>
      <Image Source="{Binding ImagePath,Converter={StaticResource Thumbnail}}" Width="100" Height="96" RenderOptions.BitmapScalingMode="HighQuality"/>
      <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#163D43" BorderBrush="{StaticResource GoldMutedBrush}" BorderThickness="1" Padding="6,2" Visibility="{Binding UnitsBadge,Converter={StaticResource NonEmpty}}">
       <TextBlock Text="{Binding UnitsBadge}" Foreground="{StaticResource GoldBrush}" FontWeight="SemiBold"/>
      </Border>
     </Grid>
     <StackPanel Grid.Row="2" VerticalAlignment="Center">
      <TextBlock Text="{Binding Name}" FontFamily="Georgia" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
      <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
    </Grid>
   </local:OrnateFrame>
  </DataTemplate>
  <DataTemplate x:Key="CheatCard">
   <local:OrnateFrame Background="{StaticResource CardBrush}" BorderBrush="#647057" BorderThickness="1" Padding="18,12" CornerSize="9" Ornament="False" Margin="0,0,0,9">
    <Grid>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="49"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="124"/>
      <ColumnDefinition Width="92"/>
      <ColumnDefinition Width="58"/>
     </Grid.ColumnDefinitions>
     <Image Source="{Binding Id,Converter={StaticResource CheatArtwork}}" Width="29" Height="34" Margin="0,0,13,0"/>
     <StackPanel Grid.Column="1" Margin="0,0,14,0">
      <TextBlock Text="{Binding Name}" FontFamily="Georgia" FontSize="18"/>
      <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Note}" Foreground="{Binding Note,Converter={StaticResource CheatNoteBrush}}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
     </StackPanel>
     <Border Grid.Column="2" Background="#071D29" BorderBrush="#547078" BorderThickness="1" CornerRadius="4" Padding="10,7" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="{Binding Hotkey}" FontSize="11" Foreground="#D1DDD5"/>
     </Border>
     <TextBlock Grid.Column="3" Text="{Binding State}" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     <CheckBox Grid.Column="4" Style="{StaticResource Toggle}" IsChecked="{Binding Active,Mode=OneWay}" IsEnabled="{Binding Available}" Tag="{Binding}" Click="CheatClick" ToolTip="{Binding Note}" AutomationProperties.Name="{Binding Name}"/>
    </Grid>
   </local:OrnateFrame>
  </DataTemplate>
 </Window.Resources>
 <Border BorderBrush="#8B794C" BorderThickness="1">
  <Grid>
   <Grid.RowDefinitions>
    <RowDefinition Height="37"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="35"/>
   </Grid.RowDefinitions>
   <Grid Background="#05121C" MouseLeftButtonDown="TitleDrag">
    <StackPanel Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center">
     <Image Source="{StaticResource TriforceImage}" Width="19" Height="18" Margin="0,0,12,0"/>
     <TextBlock Text="HYRULE COMPANION" FontFamily="Georgia" FontSize="12" Foreground="{StaticResource GoldBrush}"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button Content="─" Style="{StaticResource Ghost}" Padding="18,8" Click="MinimizeClick" AutomationProperties.Name="Minimize"/>
     <Button Content="□" Style="{StaticResource Ghost}" Padding="18,8" Click="MaximizeClick" AutomationProperties.Name="Maximize or restore"/>
     <Button Content="✕" Style="{StaticResource Ghost}" Padding="18,8" Click="CloseClick" AutomationProperties.Name="Close"/>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions>
     <ColumnDefinition x:Name="SidebarColumn" Width="224"/>
     <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Background="#071A24" BorderBrush="{StaticResource GoldLineBrush}" BorderThickness="0,0,1,0">
     <Grid>
      <Border Background="{StaticResource AncientPatternBrush}" IsHitTestVisible="False"/>
      <Grid Margin="15,20,15,17">
       <Grid.RowDefinitions>
        <RowDefinition x:Name="SidebarHeaderRow" Height="194"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
       </Grid.RowDefinitions>
       <StackPanel HorizontalAlignment="Center">
        <Image Source="{StaticResource CrestImage}" Width="139" Height="78"/>
        <TextBlock Text="HYRULE" FontFamily="Georgia" FontSize="29" HorizontalAlignment="Center" Foreground="#F1D99E" Margin="0,13,0,0"/>
        <TextBlock Text="C O M P A N I O N" FontSize="11" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        <Image Source="{StaticResource EyeImage}" Width="32" Height="25" Margin="0,11,0,0"/>
       </StackPanel>
       <StackPanel Grid.Row="1">
        <Button x:Name="NavItems" Style="{StaticResource Nav}" Tag="items" Click="NavigateClick">
         <StackPanel Orientation="Horizontal">
          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,13,0" Foreground="{StaticResource GoldBrush}"/>
          <TextBlock Text="Item browser" FontSize="16"/>
         </StackPanel>
        </Button>
        <Button x:Name="NavCheats" Style="{StaticResource Nav}" Tag="cheats" Click="NavigateClick">
         <StackPanel Orientation="Horizontal">
          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,13,0" Foreground="{StaticResource GoldBrush}"/>
          <TextBlock Text="Cheats" FontSize="16"/>
         </StackPanel>
        </Button>
        <Button x:Name="NavTravel" Style="{StaticResource Nav}" Tag="travel" Click="NavigateClick">
         <StackPanel Orientation="Horizontal">
          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,13,0" Foreground="{StaticResource GoldBrush}"/>
          <TextBlock Text="Travel" FontSize="16"/>
         </StackPanel>
        </Button>
        <Border Height="1" Background="#4C5748" Margin="13,17"/>
        <Button x:Name="NavSettings" Style="{StaticResource Nav}" Tag="settings" Click="NavigateClick">
         <StackPanel Orientation="Horizontal">
          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,13,0" Foreground="{StaticResource GoldBrush}"/>
          <TextBlock Text="Settings" FontSize="16"/>
         </StackPanel>
        </Button>
       </StackPanel>
       <StackPanel Grid.Row="2">
        <local:OrnateFrame Style="{StaticResource PanelFrame}" Padding="15" CornerSize="10">
         <StackPanel>
          <TextBlock Text="QUICK RESET" Foreground="{StaticResource GoldBrush}" FontSize="11"/>
          <TextBlock Text="Turn off every cheat" FontSize="12" Margin="0,9,0,7"/>
          <TextBlock Text="Ctrl + Alt + F12" Foreground="{StaticResource Muted}" FontSize="11"/>
          <Button Content="Disable all" Click="DisableAllClick" Margin="0,13,0,0" Padding="10,8"/>
         </StackPanel>
        </local:OrnateFrame>
        <Image Source="{StaticResource EyeImage}" Width="31" Height="27" Opacity=".7" Margin="0,15,0,0"/>
        <TextBlock Text="LOCAL • PERSONAL USE" Foreground="{StaticResource Muted}" FontSize="8" HorizontalAlignment="Center" Margin="0,8,0,0"/>
       </StackPanel>
      </Grid>
     </Grid>
    </Border>
    <Grid Grid.Column="1" Background="{StaticResource WindowBrush}">
     <Border Background="{StaticResource AncientPatternBrush}" IsHitTestVisible="False"/>
     <Grid Margin="22,17,22,14">
      <Grid.RowDefinitions>
       <RowDefinition x:Name="HeroRow" Height="146"/>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <local:OrnateFrame BorderBrush="{StaticResource GoldLineBrush}" BorderThickness="1" CornerSize="15" Background="{StaticResource SceneBrush}" Padding="23,18">
       <Grid>
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="205"/>
        </Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="2" Margin="-18,-13" IsHitTestVisible="False">
         <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
           <GradientStop Color="#E8052030"/>
           <GradientStop Color="#9D082737" Offset=".33"/>
           <GradientStop Color="#00082030" Offset=".72"/>
          </LinearGradientBrush>
         </Border.Background>
        </Border>
        <StackPanel VerticalAlignment="Center">
         <TextBlock Text="THE LEGEND OF ZELDA" FontFamily="Georgia" Foreground="#F2D58D" FontSize="13"/>
         <TextBlock Text="Tears of the Kingdom" FontFamily="Georgia" FontStyle="Italic" FontSize="31" Foreground="#FFF3D5" Margin="0,6,0,0"/>
         <TextBlock Text="A little more freedom in Hyrule." FontFamily="Georgia" FontStyle="Italic" Foreground="#E2E5CB" FontSize="12" Margin="1,10,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
         <Border Background="#E5082029" BorderBrush="#75896A" BorderThickness="1" CornerRadius="15" Padding="13,8" HorizontalAlignment="Right">
          <StackPanel Orientation="Horizontal">
           <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#E5C276" Margin="0,0,8,0"/>
           <TextBlock x:Name="ConnectionStatus" Text="Not connected" FontSize="12"/>
          </StackPanel>
         </Border>
         <Button x:Name="ConnectButton" Content="Connect to game" Click="ConnectClick" Style="{StaticResource Primary}" Margin="0,11,0,0" HorizontalAlignment="Right" Padding="19,10"/>
        </StackPanel>
       </Grid>
      </local:OrnateFrame>
      <local:OrnateFrame Grid.Row="1" x:Name="NoticeBorder" Background="#122D32" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" Padding="14,10" CornerSize="7" Ornament="False" Margin="0,10,0,0" Visibility="Collapsed">
       <TextBlock x:Name="Notice" Foreground="{StaticResource WarningBrush}" FontSize="12" TextWrapping="Wrap"/>
      </local:OrnateFrame>
      <Grid Grid.Row="2" Margin="0,19,0,0">
       <Grid x:Name="ItemsPage">
        <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
         <Grid>
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="Auto"/>
           <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
           <Image Source="{StaticResource TriforceImage}" Width="29" Height="27" Margin="0,0,13,0"/>
           <TextBlock Text="Item browser" Style="{StaticResource Heading}"/>
          </StackPanel>
          <Image Grid.Column="1" Source="{StaticResource SeparatorImage}" Height="13" Stretch="Fill" Margin="22,0,0,0" Opacity=".75"/>
         </Grid>
         <TextBlock x:Name="CatalogCaption" Style="{StaticResource Caption}" Margin="1,6,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition x:Name="DetailsColumn" Width="294"/>
         </Grid.ColumnDefinitions>
         <Grid Margin="0,0,17,0">
          <Grid.RowDefinitions>
           <RowDefinition Height="43"/>
           <RowDefinition Height="Auto"/>
           <RowDefinition Height="40"/>
           <RowDefinition Height="*"/>

          </Grid.RowDefinitions>
          <Grid>
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="133"/>
           </Grid.ColumnDefinitions>
           <TextBox x:Name="SearchBox" TextChanged="SearchChanged" Padding="15,10" ToolTip="Search names, actor IDs or item types · Ctrl+F" AutomationProperties.Name="Search items"/>
           <TextBlock x:Name="SearchHint" Text="Search items or actor IDs…" Foreground="{StaticResource Muted}" Margin="16,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="12"/>
           <Button Grid.Column="1" x:Name="FavoritesButton" Content="☆ Favorites" Click="FavoritesClick" Margin="9,0,0,0" Padding="8,9"/>
          </Grid>
          <WrapPanel Grid.Row="1" x:Name="CategoryChips" Margin="0,12,0,0"/>
          <Grid Grid.Row="2" Margin="0,1,0,8">
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="145"/>
            <ColumnDefinition Width="148"/>
           </Grid.ColumnDefinitions>
           <TextBlock x:Name="ResultCount" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
           <ComboBox Grid.Column="1" x:Name="GroupFilter" SelectionChanged="FilterChanged" Margin="0,0,7,0" AutomationProperties.Name="Filter item type"/>
           <ComboBox Grid.Column="2" x:Name="SortBox" SelectionChanged="FilterChanged" AutomationProperties.Name="Sort items">
            <ComboBoxItem Content="Name A–Z" IsSelected="True"/>
            <ComboBoxItem Content="Favorites first"/>
            <ComboBoxItem Content="Recently selected"/>
           </ComboBox>
          </Grid>
          <ListBox Grid.Row="3" x:Name="ItemList" SelectionChanged="ItemSelected" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" SizeChanged="ItemViewportChanged" AutomationProperties.Name="Item results">
           <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Focusable" Value="False"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
           <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
           <ListBox.ItemTemplate><DataTemplate><ListBox ItemsSource="{Binding}" PreviewMouseWheel="ItemRowMouseWheel" ItemTemplate="{StaticResource ItemCard}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" KeyboardNavigation.DirectionalNavigation="Continue"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,11,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="3" x:Name="EmptyResults" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
           <Image Source="{StaticResource EyeImage}" Width="54" Height="48" Opacity=".65" Margin="0,0,0,17"/>
           <TextBlock Text="Nothing found in Hyrule." FontFamily="Georgia" FontSize="20"/>
           <TextBlock Text="Try another name or clear your filters." Style="{StaticResource Caption}" Margin="0,10,0,16"/>
           <Button Content="Clear filters" Click="ClearFiltersClick"/>
          </StackPanel>

         </Grid>
         <local:OrnateFrame Grid.Column="1" Style="{StaticResource PanelFrame}" Padding="19,16">
          <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
           <StackPanel>
            <Grid>
             <TextBlock Text="SELECTED ITEM" Foreground="{StaticResource GoldBrush}" FontSize="11" VerticalAlignment="Center"/>
             <Button x:Name="DetailFavorite" Content="☆" Click="DetailFavoriteClick" Style="{StaticResource Ghost}" Padding="4,0" FontSize="23" HorizontalAlignment="Right" AutomationProperties.Name="Favorite selected item"/>
            </Grid>
            <Grid Height="132" Margin="0,8,0,8">
             <Ellipse Fill="{StaticResource ArtHaloBrush}" Width="170" Height="137"/>
             <local:SheikahSeal Width="135" Height="135" Opacity=".23"/>
             <Image x:Name="DetailImage" Width="127" Height="127" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
            <TextBlock x:Name="DetailCategory" Foreground="{StaticResource CyanBrush}" FontSize="10"/>
            <TextBlock x:Name="DetailName" FontFamily="Georgia" FontSize="25" TextWrapping="Wrap" Margin="0,7,0,9"/>
            <Border Background="#091D27" BorderBrush="#435C62" BorderThickness="1" Padding="9,7">
             <TextBlock x:Name="DetailId" FontFamily="Consolas" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap"/>
            </Border>
            <Button Content="Copy actor ID" Click="CopyIdClick" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Margin="0,5,0,0" Padding="0,6" FontSize="11"/>
            <Image Source="{StaticResource SeparatorImage}" Height="13" Stretch="Fill" Margin="0,10,0,13"/>
            <Grid>
             <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
             </Grid.ColumnDefinitions>
             <StackPanel Margin="0,0,9,0">
              <TextBlock Text="Quantity" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,7"/>
              <TextBox x:Name="QuantityBox" Text="1" AutomationProperties.Name="Spawn quantity"/>
             </StackPanel>
             <StackPanel Grid.Column="1">
              <TextBlock Text="Distance (m)" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,7"/>
              <TextBox x:Name="DistanceBox" Text="2" AutomationProperties.Name="Spawn distance in meters"/>
             </StackPanel>
            </Grid>
            <TextBlock Text="In front of Link" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,11,0,0"/>
            <Button x:Name="SpawnButton" Content="Spawn item" Click="SpawnClick" Style="{StaticResource Primary}" IsEnabled="False" Margin="0,16,0,0" Padding="15,12"/>
            <TextBlock x:Name="SpawnStatus" Style="{StaticResource Caption}" Foreground="{StaticResource WarningBrush}" Margin="0,12,0,0"/>
            <TextBlock x:Name="SpecialItemNote" Style="{StaticResource Caption}" Foreground="{StaticResource WarningBrush}" Visibility="{Binding Text,RelativeSource={RelativeSource Self},Converter={StaticResource NonEmpty}}" Margin="0,10,0,0"/>
           </StackPanel>
          </ScrollViewer>
         </local:OrnateFrame>
        </Grid>
       </Grid>
       <Grid x:Name="CheatsPage" Visibility="Collapsed">
        <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,17">
         <StackPanel>
          <TextBlock Text="Play your way" Style="{StaticResource Heading}" FontStyle="Italic"/>
          <TextBlock Text="Fine-tune your adventure. Toggle only what you need." Style="{StaticResource Caption}" Margin="0,7,0,0"/>
         </StackPanel>
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <CheckBox x:Name="ActiveOnly" Content="Active only" Click="ActiveOnlyClick"/>
          <TextBlock x:Name="ActiveCount" Text="0 active" Foreground="{StaticResource CyanBrush}" Margin="19,0,0,0" VerticalAlignment="Center"/>
         </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
         <StackPanel Margin="0,0,10,0">
          <local:OrnateFrame Background="{StaticResource PresetSceneBrush}" BorderBrush="{StaticResource GoldLineBrush}" BorderThickness="1" Padding="20,17" Margin="0,0,0,14">
           <Grid>
            <StackPanel>
             <TextBlock Text="EXPLORATION PRESET" FontSize="11" Foreground="{StaticResource GoldBrush}"/>
             <TextBlock Text="More time for discovery" FontFamily="Georgia" FontSize="21" Margin="0,6,0,0"/>
             <TextBlock Text="Infinite health, stamina and battery." FontSize="12" Foreground="#E3EBD7" Margin="0,6,0,0"/>
            </StackPanel>
            <Button Content="Enable preset" Click="PresetClick" Style="{StaticResource Primary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
           </Grid>
          </local:OrnateFrame>
          <ItemsControl x:Name="CheatList" ItemTemplate="{StaticResource CheatCard}">
           <ItemsControl.GroupStyle>
            <GroupStyle>
             <GroupStyle.HeaderTemplate>
              <DataTemplate>
               <Grid Margin="0,15,0,12">
                <Grid.ColumnDefinitions>
                 <ColumnDefinition Width="Auto"/>
                 <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" FontFamily="Georgia" FontSize="19" Foreground="{StaticResource GoldBrush}" Margin="0,0,15,0"/>
                <Border Grid.Column="1" Height="1" Background="{StaticResource GoldLineBrush}" VerticalAlignment="Center"/>
               </Grid>
              </DataTemplate>
             </GroupStyle.HeaderTemplate>
            </GroupStyle>
           </ItemsControl.GroupStyle>
          </ItemsControl>
          <local:OrnateFrame Style="{StaticResource PanelFrame}" Margin="0,13,0,0">
           <StackPanel>
            <TextBlock Text="Movement tuning" FontFamily="Georgia" FontSize="19" Foreground="{StaticResource GoldBrush}"/>
            <Grid Margin="0,17,0,0">
             <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="65"/>
             </Grid.ColumnDefinitions>
             <TextBlock Text="Movement speed" VerticalAlignment="Center"/>
             <Slider Grid.Column="1" x:Name="SpeedSlider" Minimum="0.25" Maximum="3" Value="1" TickFrequency="0.25" IsSnapToTickEnabled="True" ValueChanged="SpeedChanged" AutomationProperties.Name="Movement speed multiplier"/>
             <TextBlock Grid.Column="2" x:Name="SpeedLabel" Text="1.00×" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <Grid Margin="0,14,0,0">
             <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="65"/>
             </Grid.ColumnDefinitions>
             <TextBlock Text="Jump height" VerticalAlignment="Center"/>
             <Slider Grid.Column="1" x:Name="JumpSlider" Minimum="1" Maximum="5" Value="2" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="JumpChanged" AutomationProperties.Name="Jump height multiplier"/>
             <TextBlock Grid.Column="2" x:Name="JumpLabel" Text="2.0×" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="Enable the corresponding cheat above to apply a multiplier. High jump is experimental." Style="{StaticResource Caption}" Margin="0,13,0,0"/>
           </StackPanel>
          </local:OrnateFrame>
          <TextBlock Text="Every cheat starts off. Changes apply only while its switch is enabled." Style="{StaticResource Caption}" Margin="3,15,3,10"/>
         </StackPanel>
        </ScrollViewer>
       </Grid>
       <Grid x:Name="TravelPage" Visibility="Collapsed">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Grid Margin="0,0,0,15"><StackPanel><TextBlock Text="Explore. Mark. Travel." Style="{StaticResource Heading}"/><TextBlock Text="Click to choose a destination • double-click to teleport • drag to pan" Style="{StaticResource Caption}" Margin="0,7,0,0"/></StackPanel><TextBlock x:Name="PlayerCoordinatesLabel" Text="Connect to locate Link" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
 <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
 <StackPanel Orientation="Horizontal"><Button x:Name="LayerSurface" Tag="Surface" Content="Surface" Click="MapLayerClick" Style="{StaticResource CategoryChip}"/><Button x:Name="LayerSky" Tag="Sky" Content="Sky" Click="MapLayerClick" Style="{StaticResource CategoryChip}"/><Button x:Name="LayerDepths" Tag="Depths" Content="Depths" Click="MapLayerClick" Style="{StaticResource CategoryChip}"/></StackPanel>
 <TextBox Grid.Column="1" x:Name="MapSearch" TextChanged="MapFilterChanged" ToolTip="Search shrines, towers, lightroots or saved places" AutomationProperties.Name="Search map destinations" Margin="12,0,10,7" Padding="10,7"/>
 <TextBlock Grid.Column="1" Text="Search map destinations…" Foreground="{StaticResource Muted}" FontSize="11" Margin="23,0,20,7" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=MapSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ComboBox Grid.Column="2" x:Name="MapKindFilter" SelectionChanged="MapKindChanged" Margin="0,0,0,7" AutomationProperties.Name="Map marker filter"><ComboBoxItem Content="All landmarks" IsSelected="True"/><ComboBoxItem Content="Shrine"/><ComboBoxItem Content="Tower"/><ComboBoxItem Content="Lightroot"/><ComboBoxItem Content="Saved"/></ComboBox></Grid>
 <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
 <local:OrnateFrame Style="{StaticResource PanelFrame}" Padding="1" Margin="0,0,15,0"><Grid><local:HyruleMap x:Name="TravelMap" AutomationProperties.Name="Interactive Hyrule map"/>
 <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,40,0,0"><Button Content="+" Click="MapZoomIn" ToolTip="Zoom in" Padding="12,7"/><Button Content="−" Click="MapZoomOut" ToolTip="Zoom out" Padding="12,7" Margin="0,5,0,0"/><Button Content="⌖" Click="MapLocatePlayer" ToolTip="Center on Link" Padding="12,7" Margin="0,5,0,0"/><Button Content="Fit" Click="MapFit" ToolTip="Show the whole map" Padding="8,7" Margin="0,5,0,0"/></StackPanel>
 <Border Background="#D9071923" VerticalAlignment="Bottom" Padding="10,7"><Grid><TextBlock x:Name="MapPointerLabel" Text="Wheel to zoom • drag to explore" Foreground="{StaticResource GoldBrush}" FontSize="10"/><TextBlock Text="Basemap © Nintendo" FontSize="9" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/></Grid></Border>
 </Grid></local:OrnateFrame>
 <local:OrnateFrame Grid.Column="1" Style="{StaticResource PanelFrame}" Padding="17"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
 <TextBlock Text="DESTINATION" Foreground="{StaticResource GoldBrush}" FontSize="11"/><TextBlock x:Name="DestinationName" Text="Choose your next stop" FontFamily="Georgia" FontSize="23" TextWrapping="Wrap" Margin="0,10,0,8"/>
 <TextBlock x:Name="CoordinateExplanation" Text="World coordinates • X east / Z south / Y height" Style="{StaticResource Caption}" FontSize="10"/>
 <ComboBox x:Name="CoordinateSpace" SelectionChanged="CoordinateSpaceChanged" Margin="0,10,0,0" AutomationProperties.Name="Coordinate format"><ComboBoxItem Content="Engine coordinates" IsSelected="True"/><ComboBoxItem Content="In-game HUD coordinates"/></ComboBox><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="X (east / west)" Style="{StaticResource Caption}" FontSize="11"/><TextBox x:Name="TravelX" Text="0" TextChanged="TravelCoordinateChanged" AutomationProperties.Name="Destination X" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="HorizontalCoordinateLabel" Text="Z (south / north)" Style="{StaticResource Caption}" FontSize="11"/><TextBox x:Name="TravelZ" Text="0" TextChanged="TravelCoordinateChanged" AutomationProperties.Name="Destination Z" Margin="0,6,0,0"/></StackPanel></Grid>
 <TextBlock x:Name="AltitudeCoordinateLabel" Text="Y — altitude (meters)" Style="{StaticResource Caption}" Margin="0,12,0,6"/><TextBox x:Name="TravelY" Text="" TextChanged="TravelCoordinateChanged" ToolTip="Required for arbitrary map points; landmarks include their measured height" AutomationProperties.Name="Destination altitude Y"/>
 <TextBlock x:Name="TravelCoordinateStatus" Text="Select a landmark or enter all three coordinates." Style="{StaticResource Caption}" Foreground="{StaticResource WarningBrush}" Margin="0,10,0,0"/>
 <Button x:Name="CoordinateTravelButton" Content="Teleport here" Click="CoordinateTravelClick" Style="{StaticResource Primary}" IsEnabled="False" Margin="0,13,0,0"/><CheckBox x:Name="MapClickTeleport" Content="Teleport on single map click" FontSize="11" Margin="0,12,0,3" ToolTip="Uses the entered altitude for arbitrary map points"/><Button x:Name="UndoTravelButton" Content="Undo last teleport" Click="UndoTravelClick" IsEnabled="False" Margin="0,9,0,0"/>
 <TextBlock x:Name="MapAltitudeHelp" Text="A map click sets X and Z. Set altitude before teleporting: the map does not measure terrain height. Long-distance travel is experimental." Style="{StaticResource Caption}" FontSize="11" Margin="0,13,0,0"/>
 <Image Source="{StaticResource SeparatorImage}" Height="13" Stretch="Fill" Margin="0,18"/>
 <TextBlock Text="Destinations" FontFamily="Georgia" FontSize="19" Foreground="{StaticResource GoldBrush}"/><ListBox x:Name="LandmarkList" Height="155" SelectionChanged="LandmarkSelected" Margin="0,10,0,0" AutomationProperties.Name="Map landmarks"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="7,6"><TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Kind}" Style="{StaticResource Caption}" FontSize="10" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
 <TextBlock Text="Your saved places" FontFamily="Georgia" FontSize="19" Foreground="{StaticResource GoldBrush}" Margin="0,18,0,10"/>
 <TextBox x:Name="PlaceNameBox" ToolTip="Name a saved destination or your current location" AutomationProperties.Name="Saved place name"/><WrapPanel Margin="0,8,0,0"><Button Content="Save current" Click="SavePlaceClick" Padding="9,8" FontSize="11" Margin="0,0,8,6"/><Button Content="Save destination" Click="SaveDestinationClick" Padding="9,8" FontSize="11" Margin="0,0,0,6"/></WrapPanel>
 <ListBox x:Name="PlaceList" MaxHeight="160" SelectionChanged="SavedMapPlaceSelected" AutomationProperties.Name="Saved places"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="7,6"><TextBlock Text="{Binding Name}" FontSize="13"/><TextBlock Text="{Binding Coordinates}" Style="{StaticResource Caption}" FontSize="10" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
 <WrapPanel Margin="0,9,0,0"><Button x:Name="TravelButton" Content="Travel to saved place" Click="TravelClick" Padding="9,8" FontSize="11" Margin="0,0,8,6"/><Button Content="Remove" Click="RemovePlaceClick" Padding="9,8" FontSize="11"/></WrapPanel>
 </StackPanel></ScrollViewer></local:OrnateFrame></Grid>
 </Grid>
       <Grid x:Name="SettingsPage" Visibility="Collapsed">
        <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
         <TextBlock Text="Make it yours" Style="{StaticResource Heading}"/>
         <TextBlock Text="Your connection, shortcuts and preferences. Saved automatically." Style="{StaticResource Caption}" Margin="0,7,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
         <StackPanel Margin="0,0,10,0">
          <local:OrnateFrame Style="{StaticResource PanelFrame}">
           <StackPanel>
            <TextBlock Text="Game connection" FontFamily="Georgia" FontSize="21" Foreground="{StaticResource GoldBrush}"/>
            <TextBlock Text="TOTK 1.2.1 • Windows recomp" Style="{StaticResource Caption}" Margin="0,8,0,14"/>
            <Grid>
             <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="110"/>
             </Grid.ColumnDefinitions>
             <TextBox x:Name="GamePathBox" IsReadOnly="True" FontSize="12" AutomationProperties.Name="Game executable path"/>
             <Button Grid.Column="1" Content="Browse…" Click="BrowseClick" Margin="10,0,0,0"/>
            </Grid>
            <TextBlock Text="Connecting only reads the game. A cheat changes values after you switch it on." Style="{StaticResource Caption}" Margin="0,13,0,0"/>
           </StackPanel>
          </local:OrnateFrame>
          <local:OrnateFrame Style="{StaticResource PanelFrame}" Margin="0,16,0,0">
           <StackPanel>
            <TextBlock Text="Keyboard shortcuts" FontFamily="Georgia" FontSize="21" Foreground="{StaticResource GoldBrush}"/>
            <TextBlock Text="Click a shortcut and press your new combination. Use Ctrl, Alt or Shift with a key. Shortcuts work while the game is focused." Style="{StaticResource Caption}" Margin="0,9,0,15"/>
            <ItemsControl x:Name="HotkeyList">
             <ItemsControl.ItemTemplate>
              <DataTemplate>
               <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                 <ColumnDefinition Width="*"/>
                 <ColumnDefinition Width="190"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding Hotkey,Mode=OneWay}" IsReadOnly="True" Tag="{Binding}" PreviewKeyDown="CaptureHotkey" ToolTip="Press a shortcut; Delete removes it" FontSize="12" AutomationProperties.Name="{Binding Name}"/>
               </Grid>
              </DataTemplate>
             </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid Margin="0,12,0,4">
             <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="190"/>
             </Grid.ColumnDefinitions>
             <TextBlock Text="Spawn selected item" VerticalAlignment="Center"/>
             <TextBox Grid.Column="1" x:Name="SpawnShortcutBox" IsReadOnly="True" PreviewKeyDown="CaptureSpawnHotkey" AutomationProperties.Name="Spawn selected item shortcut"/>
            </Grid>
            <Border Height="1" Background="{StaticResource SoftLineBrush}" Margin="0,15"/>
            <TextBlock Text="Disable all: Ctrl + Alt + F12  •  Search items: Ctrl + F" Foreground="{StaticResource GoldBrush}" FontSize="12"/>
            <Button Content="Restore default shortcuts" Click="ResetHotkeysClick" HorizontalAlignment="Left" Margin="0,17,0,0"/>
           </StackPanel>
          </local:OrnateFrame>
          <local:OrnateFrame Style="{StaticResource PanelFrame}" Margin="0,16,0,12">
           <StackPanel>
            <TextBlock Text="Preferences" FontFamily="Georgia" FontSize="21" Foreground="{StaticResource GoldBrush}" Margin="0,0,0,18"/>
            <CheckBox x:Name="TopmostCheck" Content="Keep this window on top" Click="TopmostClick"/>
            <CheckBox x:Name="ReturnToGameCheck" Content="Return to the game when spawning" Click="ReturnToGameClick" Margin="0,17,0,0"/>
            <CheckBox x:Name="ReduceMotionCheck" Content="Reduce interface animations" Click="ReduceMotionClick" Margin="0,17,0,0"/>
            <Button Content="Save connection report" Click="ReportClick" HorizontalAlignment="Left" Margin="0,22,0,0"/>
            <TextBlock Text="Hyrule Companion • 0.3 map edition" Foreground="{StaticResource GoldBrush}" FontSize="12" Margin="0,24,0,9"/>
            <TextBlock Text="Item names and icons: Marc Robledo’s TOTK save editor; names compiled by Echocolat, Exincracci, HylianLZ and Karlos007. Game assets belong to Nintendo. Cheat research: Eiffel2018 and the Switch cheats community. Source and license details are included with this app." Style="{StaticResource Caption}" FontSize="11"/>
           </StackPanel>
          </local:OrnateFrame>
         </StackPanel>
        </ScrollViewer>
       </Grid>
      </Grid>
     </Grid>
    </Grid>
   </Grid>
   <Border Grid.Row="2" BorderBrush="{StaticResource GoldLineBrush}" BorderThickness="0,1,0,0" Background="#06151E">
    <Grid Margin="18,0">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Image Source="{StaticResource EyeImage}" Width="21" Height="19" Margin="0,0,10,0"/>
      <TextBlock x:Name="FooterStatus" Text="Ready to browse • cheats are off" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
     </StackPanel>
     <TextBlock Grid.Column="1" Margin="20,0,0,0" Text="TOTK 1.2.1  /  HYRULE COMPANION 0.3" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
   </Border>
  </Grid>
 </Border>
</Window>
